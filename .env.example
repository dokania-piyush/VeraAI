# Copy to .env, then replace identity fields. Never commit .env.
VERA_TEAM_NAME=Vera Compass
VERA_TEAM_MEMBERS=SET_YOUR_NAME
VERA_CONTACT_EMAIL=SET_YOUR_EMAIL
VERA_SUBMITTED_AT=2026-09-27T00:00:00Z
VERA_DB_PATH=./data/vera.sqlite3
PORT=8080

# Generate a private token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Studio is disabled until this is set. Never reuse the test-suite tokens.
VERA_ADMIN_TOKEN=

# Leave blank for the public judge unless organizers confirm bearer-token support.
# An unauthenticated challenge service is NOT safe for real customer data.
VERA_API_TOKEN=
VERA_PUBLIC_STUDIO=false

VERA_MERCHANT_COOLDOWN=1800
VERA_CUSTOMER_COOLDOWN=86400
VERA_RETENTION_HOURS=4

# Default composition is fully deterministic and makes no LLM requests.
# Optional semantic mode classifies only otherwise-unrecognized replies.
VERA_SEMANTIC_ENABLED=false
VERA_LLM_BASE_URL=https://api.openai.com/v1
VERA_LLM_MODEL=
VERA_LLM_API_KEY=
VERA_LLM_TIMEOUT=3
VERA_LLM_MAX_CALLS=100

# Optional independent outbound quality reviewer. Explicit --allow-paid required.
VERA_JUDGE_BASE_URL=https://api.openai.com/v1
VERA_JUDGE_MODEL=
VERA_JUDGE_API_KEY=
